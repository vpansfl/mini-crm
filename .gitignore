# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors / IDE
.idea/
*.iml
.vscode/*
!.vscode/extensions.json

# Env files (secrets: HubSpot token, DB credentials, etc.)
.env
.env.*
!.env.example

# Secret / certificate files (e.g. Aiven CA certificate, keystores)
*.pem
*.key
*.p12
*.jks
*.keystore
secrets/

# Deploy tool local state (Vercel / Render CLI)
.vercel/
.render/

# Logs
*.log

# Node (frontend/ has its own .gitignore as well)
node_modules/
frontend/dist/

# Backend (Spring Boot: Gradle / Maven)
backend/build/
backend/.gradle/
backend/target/
backend/out/
backend/bin/
backend/src/main/resources/application-local.*

# Claude Code local settings
.claude/settings.local.json
